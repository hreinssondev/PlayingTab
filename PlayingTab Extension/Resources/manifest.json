{
  "manifest_version": 3,
  "name": "PlayingTab",
  "version": "1.0",
  "description": "Jump to the tab that is playing audio or video.",
  "permissions": ["tabs", "storage"],
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_start"
    }
  ],
  "commands": {
    "go-to-playing": {
      "suggested_key": { "default": "Alt+Shift+P", "mac": "Alt+Command+P" },
      "description": "Go to the playing tab"
    }
  }
}
