{
  "manifest_version": 3,
  "name": "PlayingTab",
  "version": "1.0",
  "description": "Jump to the tab that is playing audio or video.",
  "icons": {
    "48": "images/icon-48.png",
    "64": "images/icon-64.png",
    "96": "images/icon-96.png",
    "128": "images/icon-128.png",
    "256": "images/icon-256.png",
    "512": "images/icon-512.png"
  },
  "permissions": ["tabs", "storage"],
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_start"
    }
  ],
  "commands": {
    "go-to-playing": {
      "suggested_key": { "default": "Alt+Shift+P", "mac": "Alt+Command+P" },
      "description": "Go to the playing tab"
    }
  }
}
